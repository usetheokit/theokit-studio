{
  "name": "@theokit/studio",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "TheoKit Studio — local dev UI (M1: reflection plugin + embeddable SPA)",
  "exports": {
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsup",
    "build:plugin": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@theokit/agents": ">=11.0.0 <13",
    "@theokit/sdk": "^4.49.0",
    "vite": ">=6 <9"
  },
  "dependencies": {
    "@theokit/ui": "^1.3.2",
    "@usetheo/ui": "^0.28.2",
    "lucide-react": "^0.471.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.1"
  },
  "_comments": {
    "@theokit/sdk": "SPA: types-only (`import type`); plugin node-side consome em runtime no host — por isso também peerDependency (M1 T1.1)",
    "@theokit/agents": "plugin node-side: compileAgentModule/streamAgentUIMessages do ./bridge (M1 ADR D2); devDep para fixtures/testes (EC-4)"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@theokit/agents": "^12.0.0",
    "@theokit/sdk": "^4.49.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
